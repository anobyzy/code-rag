# Engineering DB for the code index (the docker-compose service below). NOT the product DB.
# Copy to .env. Set CODE_RAG_POSTGRES_PASSWORD to a random per-project password
# and use the same value in the URL. Keep the URL port in sync with CODE_RAG_PORT.
CODE_RAG_POSTGRES_PASSWORD=
CODE_RAG_DATABASE_URL=postgresql://code_rag:REPLACE_WITH_RANDOM_HEX@127.0.0.1:5433/code_rag
CODE_RAG_PORT=5433
# Set a unique Compose project name when running multiple local indexes.
CODE_RAG_COMPOSE_PROJECT=code-rag

# Offline uses a deterministic, non-semantic embedder. Choose voyage only after
# approving transmission of indexed source excerpts and query text to Voyage.
CODE_RAG_EMBEDDING_PROVIDER=offline
VOYAGE_API_KEY=
