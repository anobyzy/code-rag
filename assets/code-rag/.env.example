# Engineering DB for the code index (the docker-compose service below). NOT the product DB.
# Copy this file to .env and adjust if you changed the port/creds in docker-compose.yml.
CODE_RAG_DATABASE_URL=postgresql://code_rag:code_rag@localhost:5433/code_rag

# Optional: Voyage voyage-code-3 embeddings. Empty = deterministic offline fallback
# (runnable/testable without network, but NON-semantic — weak retrieval quality).
VOYAGE_API_KEY=
